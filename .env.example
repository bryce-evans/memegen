# Postgres connection
DATABASE_URL=postgres://localhost:5432/memegen

# Service ports / URLs
API_PORT=4000
STORAGE_PORT=4001
STORAGE_URL=http://localhost:4001

# Shared secret for service-to-service calls and /internal routes (empty = no check)
INTERNAL_TOKEN=dev-internal-token

# Storage: default provider for new uploads (local | s3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
# S3_BUCKET=memegen
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=


# Upload caps (all optional; defaults shown)
# MAX_UPLOAD_BYTES=20971520
# MAX_IMAGE_DIMENSION=4096
# MAX_GIF_DIMENSION=1024
# MAX_GIF_FRAMES=500
# MAX_VIDEO_DIMENSION=1920
# MAX_VIDEO_FRAMES=1800
