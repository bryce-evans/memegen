# memegen — development config (committed; contains no secrets).
#   ./run.sh config/dev.env <command>
# Plain KEY=value lines; read by run.sh and by Node's --env-file.

# dev: watch mode, Vite dev server, sample data (SEED_SAMPLE) and tests allowed.
# prod: built web app, refuses SEED_SAMPLE and test commands.
MODE=dev

# Sign-in page intro, baked into the web build: basic (card only), party (memes and confetti explode out from
# behind the card), or nyan (nyan cat flies straight in from the bottom right, behind the card, and out of its top-left corner).
# Dev tools on the sign-in page preview the others.
INTRO=basic

# Postgres
DATABASE_URL=postgres://localhost:5432/memegen
TEST_DATABASE_URL=postgres://localhost:5432/memegen_test
E2E_DATABASE_URL=postgres://localhost:5432/memegen_e2e
# Snapshot tests restore into this second, empty database
SNAPSHOT_TEST_DATABASE_URL=postgres://localhost:5432/memegen_snapshot_test

# Ports (the web app proxies /api and /storage to the services)
WEB_PORT=5173
API_PORT=4000
STORAGE_PORT=4001
# The web app reaches the services on these ports at localhost; override only for split hosts:
# API_URL=http://localhost:4000
# STORAGE_URL=http://localhost:4001

# Service-to-service secret; guards /internal routes (empty = unguarded)
INTERNAL_TOKEN=dev-internal-token

# Storage: provider for new uploads (local | s3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage

# Upload caps (defaults shown)
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_DIMENSION=4096
MAX_GIF_DIMENSION=1024
MAX_GIF_FRAMES=500
MAX_VIDEO_DIMENSION=1920
MAX_VIDEO_FRAMES=1800

# `./run.sh <config> seed`: templates/fonts from a jacebrowning/memegen checkout, then the realistic
# sample dataset (scripts/sample/data.ts), whose memes are made from those templates
SEED_TEMPLATES_FROM=demo/jacebrowning-memegen
SEED_SAMPLE=true
# Dev test stickers: every PNG (≤ 512x512) in this local folder becomes a built-in sticker (gitignored, like demo/)
SEED_STICKERS_FROM=demo/stickers

# AI agents and images: users bring their own provider API keys (profile → API Keys); the server needs none. Default models shown.
# OPENAI_IMAGE_MODEL=gpt-image-2
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# OPENAI_TEXT_MODEL=gpt-5-mini
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# ANTHROPIC_TEXT_MODEL=claude-haiku-5-5

# Template search sidecar (services/search): CLIP embeddings of every template image in a FAISS index, for
# natural-language template search ("dog" finds doge) and duplicate checks on new templates. Off = name/tag search only.
# The first start downloads the model (~600 MB) into SEARCH_DATA_DIR.
SEARCH_ENABLED=true
SEARCH_PORT=4002
# SEARCH_URL=http://localhost:4002
# SEARCH_MODEL=Xenova/clip-vit-base-patch32
# SEARCH_DATA_DIR=.data/search
