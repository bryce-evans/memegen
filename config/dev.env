# memegen — development config (committed; contains no secrets).
#   ./run.sh config/dev.env <command>
# Plain KEY=value lines; read by run.sh and by Node's --env-file.

# dev: watch mode, Vite dev server, mock data and tests allowed.
# prod: built web app, guards against mock data and test commands.
MODE=dev

# Postgres
DATABASE_URL=postgres://localhost:5432/memegen
TEST_DATABASE_URL=postgres://localhost:5432/memegen_test
E2E_DATABASE_URL=postgres://localhost:5432/memegen_e2e

# Ports (the web app proxies /api and /storage to the services)
WEB_PORT=5173
API_PORT=4000
STORAGE_PORT=4001
API_URL=http://localhost:4000
STORAGE_URL=http://localhost:4001

# Service-to-service secret; guards /internal routes (empty = unguarded)
INTERNAL_TOKEN=dev-internal-token

# Storage: provider for new uploads (local | s3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage

# Upload caps (defaults shown)
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_DIMENSION=4096
MAX_GIF_DIMENSION=1024
MAX_GIF_FRAMES=500
MAX_VIDEO_DIMENSION=1920
MAX_VIDEO_FRAMES=1800

# `./run.sh <config> seed`: mock dataset (scripts/mock) and/or a jacebrowning/memegen checkout
SEED_MOCK=true
SEED_TEMPLATES_FROM=demo/jacebrowning-memegen
