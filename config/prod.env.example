# memegen — production config TEMPLATE.
#   cp config/prod.env.example config/prod.env   # config/prod.env is gitignored; put real secrets there
#   ./run.sh config/prod.env setup && ./run.sh config/prod.env start
#
# Prod mode serves the built web app, never loads mock data, and refuses test/dev commands.
# Auth is still the dev placeholder (X-User-Id). Do not expose this to untrusted users
# until a real AuthProvider is in place (see ARCH.md "Auth").

MODE=prod

# Postgres: a dedicated database for real user data
DATABASE_URL=postgres://memegen:CHANGE_ME@db.internal:5432/memegen

# Public web port (serves apps/web/dist and proxies /api and /storage)
WEB_PORT=8080
API_PORT=4000
STORAGE_PORT=4001
API_URL=http://localhost:4000
STORAGE_URL=http://localhost:4001

# REQUIRED: long random string, e.g. `openssl rand -hex 32`
INTERNAL_TOKEN=

# Storage for user uploads
STORAGE_PROVIDER=s3
S3_BUCKET=memegen-prod
S3_REGION=us-east-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # for S3-compatible stores
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=memegen/
# Or local disk:
# STORAGE_PROVIDER=local
# LOCAL_STORAGE_DIR=/var/lib/memegen/storage

# Upload caps
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_DIMENSION=4096
MAX_GIF_DIMENSION=1024
MAX_GIF_FRAMES=500
MAX_VIDEO_DIMENSION=1920
MAX_VIDEO_FRAMES=1800

# Seeding in prod: only real template imports, never mock data
SEED_MOCK=false
SEED_TEMPLATES_FROM=
