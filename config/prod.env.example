# memegen — production config TEMPLATE.
#   cp config/prod.env.example config/prod.env   # config/prod.env is gitignored; put real secrets there
#   ./run.sh config/prod.env deployment --options   # connector choices and setup links
#   ./run.sh config/prod.env deployment             # local config preflight, no network or secrets printed
#   ./run.sh config/prod.env setup && ./run.sh config/prod.env start
#
# Prod requires verified OIDC authentication and HTTPS, serves the built web app,
# refuses sample data and test/dev commands. Keep this file private after adding secrets.

MODE=prod

# REQUIRED: public HTTPS origin only, no path/query. Terminate TLS at your reverse proxy.
# Forward /api and /storage through the web server; keep service ports private.
PUBLIC_ORIGIN=https://memes.example.com

# REQUIRED: authentication connector. oidc is the only production mode.
# dev is available only with MODE=dev for trusted local development.
# Create a confidential web client at ONE provider; enable authorization code + PKCE.
# Register exactly https://memes.example.com/api/auth/callback as its redirect URI.
# Enable the openid scope. Use the issuer from the provider's discovery metadata.
# Hosted options:
#   Google: https://console.cloud.google.com/apis/credentials
#     issuer https://accounts.google.com
#   Auth0: https://manage.auth0.com/
#     issuer https://YOUR_TENANT.us.auth0.com/ (use your tenant's actual issuer)
# Open-source/self-hosted options:
#   Keycloak: https://www.keycloak.org/getting-started/getting-started-docker
#     issuer https://sso.example.com/realms/YOUR_REALM
#   Authentik: https://docs.goauthentik.io/add-secure-apps/providers/oauth2/
#     issuer https://sso.example.com/application/o/YOUR_APP/
# New identities never claim an existing account by username/email, and start non-admin.
AUTH_MODE=oidc
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Session expiry in seconds; logout revokes the session immediately.
AUTH_SESSION_TTL_SECONDS=604800

# Sign-in page intro, baked into the web build: basic (card only), party (memes and confetti explode out from
# behind the card), or nyan (nyan cat flies straight in from the bottom right, behind the card, and out of its top-left corner).
INTRO=basic

# Postgres: a dedicated database for real user data
DATABASE_URL=postgres://memegen:CHANGE_ME@db.internal:5432/memegen

# Public web port (serves apps/web/dist and proxies /api and /storage)
WEB_PORT=8080
API_PORT=4000
STORAGE_PORT=4001
# The web app reaches the services on these ports at localhost; override only for split hosts:
# API_URL=http://localhost:4000
# STORAGE_URL=http://localhost:4001

# REQUIRED: at least 32 characters, generated randomly, e.g. `openssl rand -hex 32`
INTERNAL_TOKEN=

# REQUIRED: choose a media connector: s3 or local (durable volume).
# S3: provision the bucket, grant read/write/delete for its prefix, and configure
# BOTH S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY or use the AWS role/default credential chain.
# AWS: https://console.aws.amazon.com/s3/
# Cloudflare R2: https://developers.cloudflare.com/r2/get-started/s3/ (S3_REGION=auto)
STORAGE_PROVIDER=s3
S3_BUCKET=memegen-prod
S3_REGION=us-east-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # for S3-compatible stores
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=memegen/
# Or local disk:
# STORAGE_PROVIDER=local
# LOCAL_STORAGE_DIR=/var/lib/memegen/storage

# Upload caps
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_DIMENSION=4096
MAX_GIF_DIMENSION=1024
MAX_GIF_FRAMES=500
MAX_VIDEO_DIMENSION=1920
MAX_VIDEO_FRAMES=1800

# OPTIONAL: semantic template search sidecar (CLIP + FAISS), no hosted account/key.
# Off = name/tag search and byte-identical duplicate checks. Enable after basic deployment works.
# First start downloads the model (~600 MB) into SEARCH_DATA_DIR; persist that directory.
SEARCH_ENABLED=false
SEARCH_PORT=4002
# SEARCH_URL=http://localhost:4002
# SEARCH_DATA_DIR=/var/lib/memegen/search

# OPTIONAL: AI uses each user's own OpenAI/Gemini/Anthropic key (Profile).
# No deployment-wide AI key required. Provider/model overrides are documented in README.
# OpenAI: https://platform.openai.com/api-keys
# Gemini: https://aistudio.google.com/apikey
# Anthropic: https://console.anthropic.com/

# Seeding in prod: only real template imports, never sample data or dev test stickers (SEED_STICKERS_FROM)
SEED_SAMPLE=false
SEED_TEMPLATES_FROM=
# Unified work-appropriate catalog; an empty value disables the remote-image import.
# Import checkout fonts first (Impact, Noto Sans Bold, Titillium Web SemiBold, Kalam).
SEED_TEMPLATE_MANIFEST=library/MANIFEST.json
# Maximum template content risk (integer 1–5); higher-risk previously seeded rows are hidden.
SEED_MAX_RISK=3
