# memegen — builds the starter snapshot (committed; contains no secrets). Its own database and storage, so the
# dev data never leaks into it:
#   ./run.sh config/starter.env setup
#   ./run.sh config/starter.env reset                          # templates + starter memes by memegen
#   ./run.sh config/starter.env dev                            # optional: look it over
#   ./run.sh config/starter.env snapshot save .data/snapshots/starter.zip --label starter
MODE=dev

DATABASE_URL=postgres://localhost:5432/memegen_starter

WEB_PORT=5173
API_PORT=4000
STORAGE_PORT=4001

INTERNAL_TOKEN=dev-internal-token

STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/starter-storage

# Templates and fonts from a jacebrowning/memegen checkout, then the starter memes (scripts/starter/data.ts)
SEED_TEMPLATES_FROM=demo/jacebrowning-memegen
SEED_STARTER=true
