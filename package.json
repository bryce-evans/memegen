{
  "name": "memegen",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "db:migrate": "node --env-file-if-exists=.env packages/server-kit/src/migrate.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "test": "node --test --test-concurrency=1 \"packages/*/src/**/*.test.ts\" \"services/*/src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -b apps/web",
    "build": "bun run --cwd apps/web build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@memegen/server-kit": "workspace:*",
    "@memegen/shared": "workspace:*",
    "@memegen/storage": "workspace:*"
  }
}
