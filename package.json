{
  "name": "memegen",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "faiss-node",
    "onnxruntime-node"
  ],
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"packages/*/src/**/*.test.ts\" \"services/*/src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"library/**/*.test.ts\"",
    "typecheck": "node scripts/check-boundaries.ts && tsc -p tsconfig.json && tsc -b apps/web",
    "build": "bun run --cwd apps/web build",
    "test:e2e": "node scripts/e2e.ts",
    "test:e2e:ui": "node scripts/e2e.ts --project=chrome --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "gifenc": "^1.0.3",
    "typescript": "~6.0.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@memegen/render": "workspace:*",
    "@memegen/server-kit": "workspace:*",
    "@memegen/shared": "workspace:*",
    "@memegen/storage": "workspace:*",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.0"
  }
}
